{
  "name": "jikai",
  "private": true,
  "version": "2.3.0",
  "description": "次回 jikai：ACG 追番桌面台历 —— 本季番剧、播出时间表、更新倒计时、补番 deadline、追番日记、季度报告",
  "type": "module",
  "main": "electron/main.cjs",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "desktop": "electron .",
    "assets": "node scripts/make-icons.cjs && node scripts/make-wallpaper.cjs && node scripts/make-ico.cjs",
    "shoot": "vite build && node scripts/screenshot.cjs",
    "builtin": "node scripts/build-builtin.mjs",
    "covers": "node scripts/fetch-covers.mjs",
    "dist:win": "npm run assets && npm run build && electron-builder --win --x64 --config electron-builder.yml",
    "check:tier": "node scripts/tier-render-check.mjs --drag",
    "check:tier-export": "node scripts/tier-export-check.mjs",
    "live": "node scripts/live-check.mjs",
    "live:offline": "node scripts/live-check.mjs --offline",
    "live:yuc": "node scripts/yuc-live-check.mjs",
    "live:shot": "node scripts/live-shot.cjs",
    "test": "node --test \"test/*.test.mjs\"",
    "check:desktop": "node scripts/check-desktop.mjs",
    "check:desktop:diary": "node scripts/check-desktop.mjs --view=diary --profile=test/.tmp/profile-diary --season=2026q3",
    "check:desktop:save": "node scripts/check-desktop.mjs --view=catchup --profile=test/.tmp/profile-catchup --season=2026q3 --click=8",
    "check:desktop:report": "node scripts/check-desktop.mjs --view=report --profile=test/.tmp/profile-report --season=2026q3",
    "check:desktop:export": "node scripts/check-desktop.mjs --view=report --profile=test/.tmp/profile-report --season=2026q3 --exportpng=png",
    "check:desktop:export:slice": "node scripts/check-desktop.mjs --view=report --profile=test/.tmp/profile-report --season=2026q3 --exportpng=png --noslice",
    "check:trayrevive": "node scripts/check-desktop.mjs --view=season --profile=test/.tmp/profile-trayrevive --season=2026q3 --trayrevive",
    "check:desktop:history": "node scripts/check-desktop.mjs --view=history --profile=test/.tmp/profile-history --season=2026q3",
    "check:desktop:search": "node scripts/check-desktop.mjs --view=search --profile=test/.tmp/profile-search --season=2026q3",
    "check:desktop:yuc": "node scripts/check-desktop.mjs --view=yuc --profile=test/.tmp/profile-yuc --season=2026q4",
    "check:yucwarm": "node scripts/check-desktop.mjs --view=yuc --profile=test/.tmp/profile-yucwarm --season=2026q4 --wait=25000 --yuc-covers",
    "check:desktop:wp": "node scripts/check-desktop.mjs --view=season --profile=test/.tmp/profile-wp --season=2026q3 --wp",
    "check:desktop:cardopen": "node scripts/check-desktop.mjs --view=season --profile=test/.tmp/profile-cardopen --season=2026q3 --cardopen",
    "check:maxsync": "node scripts/check-maxsync.mjs",
    "check:desktop:retryhw": "node scripts/check-desktop.mjs --view=season --profile=test/.tmp/profile-retryhw --season=2026q3 --retryhw",
    "check:killapp": "node scripts/check-killapp.mjs",
    "check:boot": "node scripts/check-boot.mjs",
    "check:ipc": "node scripts/check-ipc.mjs",
    "check:selfheal": "node scripts/check-selfheal.mjs",
    "check:coverseed": "node scripts/check-coverseed.mjs",
    "check:perf": "node scripts/perf-check.mjs",
    "scan": "node scripts/scan-privacy.mjs",
    "check:all": "npm test && npm run check:coverseed && npm run build && npm run check:tier && npm run check:tier-export && npm run check:desktop && npm run check:desktop:diary && npm run check:desktop:save && npm run check:desktop:report && npm run check:desktop:export && npm run check:desktop:export:slice && npm run check:desktop:history && npm run check:desktop:search && npm run check:desktop:yuc && npm run check:yucdetail && npm run check:keepdata && npm run check:vpscale && npm run check:desktop:cardopen && npm run check:maxsync && npm run check:trayrevive && npm run check:desktop:retryhw && npm run check:desktop:wp && npm run check:killapp && npm run check:ipc && npm run check:boot && npm run check:selfheal && npm run check:perf && npm run scan",
    "check:yucdetail": "node scripts/check-desktop.mjs --view=yuc --profile=test/.tmp/profile-yucdetail --season=2026q4 --wait=20000 --yuc-detail",
    "check:keepdata": "node scripts/check-desktop.mjs --view=season --profile=test/.tmp/profile-keepdata --season=2026q3 --keepdata",
    "check:vpscale": "node scripts/check-desktop.mjs --view=season --profile=test/.tmp/profile-vpscale --season=2026q3 --vpscale"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.0",
    "electron-builder": "^26.15.3",
    "puppeteer-core": "^25.11.0",
    "vite": "^5.4.11"
  }
}
