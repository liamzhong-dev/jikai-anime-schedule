{
  "name": "jikai",
  "private": true,
  "version": "1.0.0",
  "description": "ACG 追番桌面台历：本季番剧、播出时间表、更新倒计时、补番 deadline 卡片",
  "type": "module",
  "main": "electron/main.cjs",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "desktop": "electron .",
    "assets": "node scripts/make-icons.cjs && node scripts/make-wallpaper.cjs",
    "shoot": "vite build && node scripts/screenshot.cjs",
    "builtin": "node scripts/build-builtin.mjs",
    "check:tier": "node scripts/tier-render-check.mjs --drag",
    "check:tier-export": "node scripts/tier-export-check.mjs",
    "live": "node scripts/live-check.mjs",
    "live:offline": "node scripts/live-check.mjs --offline",
    "live:shot": "node scripts/live-shot.cjs",
    "test": "node --test \"test/*.test.mjs\"",
    "check:desktop": "node scripts/check-desktop.mjs",
    "check:desktop:diary": "node scripts/check-desktop.mjs --view=diary --profile=test/.tmp/profile-diary --season=2026q3",
    "check:desktop:save": "node scripts/check-desktop.mjs --view=catchup --profile=test/.tmp/profile-catchup --season=2026q3 --click=8",
    "check:desktop:report": "node scripts/check-desktop.mjs --view=report --profile=test/.tmp/profile-report --season=2026q3",
    "check:ipc": "node scripts/check-ipc.mjs",
    "check:selfheal": "node scripts/check-selfheal.mjs",
    "scan": "node scripts/scan-privacy.mjs",
    "check:all": "npm test && npm run build && npm run check:tier && npm run check:tier-export && npm run check:desktop && npm run check:desktop:diary && npm run check:desktop:save && npm run check:desktop:report && npm run check:ipc && npm run check:selfheal && npm run scan"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.0",
    "puppeteer-core": "^25.11.0",
    "vite": "^5.4.11"
  }
}
